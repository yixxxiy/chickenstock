; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="小鸡股市"
config/version="2026.09.20-pt2"
run/main_scene="res://scenes/Game.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.08, 0.12, 0.18, 1)
boot_splash/stretch_mode=4
boot_splash/use_filter=false
boot_splash/image="res://assets/ui/splash.png"
config/icon="res://icon.png"

[audio]

general/default_playback_type.web=0

[autoload]

Analytics="*res://scripts/Analytics.gd"

[display]

window/size/viewport_width=576
window/size/viewport_height=1024
window/stretch/mode="canvas_items"
window/handheld/orientation=1
window/vsync/vsync_mode=0

[gui]

theme/lcd_subpixel_layout=0
theme/custom="res://themes/mobile.tres"
theme/custom_font="res://fonts/game_zh_full.otf"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
rendering/textures/canvas_textures/default_texture_filter=1
